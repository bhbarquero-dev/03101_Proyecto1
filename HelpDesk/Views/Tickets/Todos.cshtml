@model IList<HelpDesk.Models.Ticket>
@{
    ViewBag.Title = "Todos los tickets";
}

<main class="mt-4">
    <h1 class="h3 mb-3">Todos los tickets</h1>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">Todavía no hay tickets registrados.</div>
    }
    else
    {
        @Html.Partial("_BusquedaTickets")
        <div class="table-responsive">
            <table id="tabla-tickets" class="table table-hover align-middle" data-con-solicitante="true">
                <thead class="table-light">
                    <tr>
                        <th scope="col">N.º</th>
                        <th scope="col">Título</th>
                        <th scope="col">Solicitante</th>
                        <th scope="col">Categoría</th>
                        <th scope="col">Estado</th>
                        <th scope="col">Asignado a</th>
                        <th scope="col">Creado</th>
                        <th scope="col">Actualizado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ticket in Model)
                    {
                        <tr>
                            <td>@ticket.Id</td>
                            <td>@Html.ActionLink(ticket.Titulo, "Detalle", "Tickets", new { id = ticket.Id }, null)</td>
                            <td>@ticket.Solicitante.Nombre</td>
                            <td>@ticket.Categoria</td>
                            <td>@Html.Partial("_EstadoBadge", ticket)</td>
                            <td>
                                @if (ticket.Asignado != null)
                                {
                                    @ticket.Asignado.Nombre
                                }
                                else
                                {
                                    <span class="text-muted fst-italic">Sin asignar</span>
                                }
                            </td>
                            <td class="text-nowrap">@ticket.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-nowrap">@ticket.FechaActualizacion.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="text-muted small">
            <span id="total-tickets">Total: @Model.Count ticket(s).</span>
            <span id="mensaje-busqueda" class="ms-2" role="status"></span>
        </p>
    }
</main>

@section scripts {
    <script src="@Url.Content("~/Scripts/busqueda-tickets.js")"></script>
}
