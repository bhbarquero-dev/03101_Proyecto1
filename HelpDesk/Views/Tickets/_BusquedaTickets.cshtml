@* Barra de busqueda instantanea (HU-07). La logica esta en Scripts/busqueda-tickets.js *@
<form id="form-busqueda" class="row g-2 align-items-end mb-3" role="search"
      action="@Url.Action("Buscar", "Tickets")" data-url-detalle="@Url.Action("Detalle", "Tickets")">
    <div class="col-sm-7 col-md-6">
        <label for="texto-busqueda" class="form-label">Buscar</label>
        <input type="search" id="texto-busqueda" name="texto" class="form-control" maxlength="150"
               autocomplete="off" placeholder="Número, título o estado" />
    </div>
    <div class="col-sm-5 col-md-3">
        <label for="estado-busqueda" class="form-label">Estado</label>
        @Html.DropDownList("idEstado", (SelectList)ViewBag.Estados, "Todos", new { id = "estado-busqueda", @class = "form-select" })
    </div>
</form>
