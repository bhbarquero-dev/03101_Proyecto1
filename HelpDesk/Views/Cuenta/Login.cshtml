@model HelpDesk.Models.LoginViewModel
@{
    ViewBag.Title = "Iniciar sesión";
}

<div class="row justify-content-center mt-5">
    <div class="col-12 col-sm-10 col-md-6 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-1">Iniciar sesión</h1>
                <p class="text-muted mb-4">Sistema de solicitudes de soporte técnico</p>

                @using (Html.BeginForm("Login", "Cuenta", new { returnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { id = "form-login", novalidate = "novalidate" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2" })

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Email, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", autocomplete = "username", autofocus = "autofocus" })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-4">
                        @Html.LabelFor(m => m.Contrasena, new { @class = "form-label" })
                        @Html.PasswordFor(m => m.Contrasena, new { @class = "form-control", autocomplete = "current-password" })
                        @Html.ValidationMessageFor(m => m.Contrasena, "", new { @class = "text-danger small" })
                    </div>

                    <button type="submit" id="btn-login" class="btn btn-primary w-100">Iniciar sesión</button>
                }
            </div>
        </div>
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        // La verificacion de la contrasena tarda unos segundos (PBKDF2 con 600 000 iteraciones):
        // se avisa al usuario y se evita que envie el formulario dos veces.
        $('#form-login').on('submit', function () {
            if ($.fn.valid && !$(this).valid()) return;
            $('#btn-login').prop('disabled', true).text('Iniciando sesión…');
        });
    </script>
}
